# Optional: use real OANDA candles instead of the built-in demo generator
# Get a token from https://www.oanda.com/

OANDA_TOKEN=47993926-64bb-4b6d-afdb-2ebaa1df798a 

# (Optional) OANDA account ID for streaming prices.
# If set and OANDA_STREAM=true, the server will connect to the OANDA streaming API.
OANDA_ACCOUNT_ID=your_oanda_account_id_here

# Optional: comma-separated list of instruments (OANDA format)
OANDA_INSTRUMENTS=GBP_USD,EUR_USD,USD_JPY

# Optional: granularity for candles (M1, M5, H1, D)
OANDA_GRANULARITY=M15

# Optional:
# - POLL_INTERVAL_MS: polling interval for REST candle mode
# - OANDA_STREAM: set to "true" to use the streaming API instead of polling
POLL_INTERVAL_MS=60000
OANDA_STREAM=false

# Optional: frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
